# 이 파일을 저장소 루트에 .env 로 복사해 값을 채운다.
# .env 는 커밋되지 않는다. 읽는 곳은 저장소 루트 한 곳뿐이라,
# 대시보드와 터미널 CLI가 같은 파일을 본다.

# 필수 — GitHub 트랙(커밋·PR·리뷰어·태그·워크플로) 수집용 토큰.
# repo 읽기 권한만 있으면 충분하다.
GITHUB_TOKEN=ghp_replace_with_your_token

# 선택 — Installed Packages 로 검사할 프로젝트 경로.
# 비워 두면 이 PC에 전역 설치된 npm 패키지(`npm ls -g`)를 검사한다.
# TRUSTGATE_PROJECT_DIR=C:/Users/me/my-project

# 선택 — 기준선 수집 범위: off | npm(추가 호출 0회) | sigstore(릴리스당 1회)
# TRUSTGATE_BASELINE=sigstore

# 선택 — 인자 없는 `npm install` / `npm ci`에서 계보를 수집할 패키지 수 상한.
# 새로 들어오는 것만, 직접 의존성부터 본다. scan_package()가 직렬화되어 있어
# 소요 시간이 개수에 비례하므로 상한이 곧 대기 시간이다. 0이면 이 단계를 끈다.
# TRUSTGATE_LINEAGE_MAX=10

# 선택 — 인자 없는 `npm install` / `npm ci`에서 알려진 취약 버전이 발견되면
# 설치를 중단한다. 기본은 경고만(0) — 규모가 있는 레포는 늘 몇 건씩 걸려서
# 기본 차단이 곧 도구 우회로 이어진다. CI에서 켜는 것을 상정한 값이다.
# TRUSTGATE_BULK_STRICT=1

# 기본 — Groq 무료 API. 결제수단 없이 Free tier 한도에서 생성형 설명을 만든다.
# 키가 없거나 한도를 넘으면 무료 로컬 증거 추론으로 자동 폴백한다.
TRUSTGATE_AI_PROVIDER=groq
GROQ_API_KEY=gsk_replace_with_your_key
TRUSTGATE_GROQ_MODEL=openai/gpt-oss-20b
# TRUSTGATE_ENABLE_AI=auto

# 선택 — OpenAI 유료 경로를 명시적으로 원할 때만 openai로 바꾼다.
# 설치: pip install -e ".[openai]"
# OPENAI_API_KEY=sk-replace_with_your_key
# TRUSTGATE_AI_MODEL=gpt-5.4-nano
# TRUSTGATE_AI_TIMEOUT_SECONDS=30

# 선택 — npm tarball을 실행하지 않고 임시 폴더에서 검사할 Semgrep 실행 파일.
# 설치: pip install -e ".[sast]"
# TRUSTGATE_SEMGREP_COMMAND=semgrep
# TRUSTGATE_SEMGREP_TIMEOUT_SECONDS=90
# TRUSTGATE_SAST_MAX_TARBALL_MB=25

# 선택 — 대시보드 실행 중 설치 의존성 OSV 점검 주기(분). 0이면 주기 점검 끔.
# 수동 "취약 버전 모니터링" 버튼과 trustgate monitor는 이 값과 무관하게 동작한다.
# TRUSTGATE_MONITOR_INTERVAL_MINUTES=60
